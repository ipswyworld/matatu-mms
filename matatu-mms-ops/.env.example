# Server-side only — the FastAPI backend, same one the staff app talks to.
BACKEND_URL=http://127.0.0.1:8000

# Own signing secret for this app's session cookie (mms_ops_session) —
# deliberately separate from the staff app's SESSION_SECRET so a compromise
# of one doesn't forge sessions in the other. Generate with:
#   openssl rand -hex 32
OPS_SESSION_SECRET=replace-with-a-long-random-value

# Where this console's Grafana panel iframe points. In production this is
# served through the same nginx :3002 server block as this app (see
# nginx/nginx.conf's Option A block), so the relative default just works.
# Only override for local dev without nginx in front.
GRAFANA_EMBED_URL=/grafana/

# Powers the Service Health Matrix (every service under this Render
# workspace + its currently-deployed commit). Optional — the matrix shows a
# "not configured" notice instead of crashing when this is unset. Generate
# at https://dashboard.render.com/u/settings#api-keys — a dedicated key for
# this console, not a personal CLI session token.
RENDER_API_KEY=
