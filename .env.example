# Copy this to .env and fill in real values before running:
#   docker compose up -d
#
# Never commit the real .env file — it's already in .gitignore.

# --- Backend ---
BACKEND_SECRET_KEY=replace-with-a-long-random-string-for-jwt-signing
# Secret path segment for the NairobiPay callback URL — NairobiPay doesn't
# sign payloads, so this is the actual authentication. Register your
# callback as https://your-domain/api/payments/nairobipay-callback/<this-value>
NAIROBIPAY_CALLBACK_SECRET=replace-with-a-long-random-string
TERMS_VERSION=2026-07-25
LOG_LEVEL=INFO
# Postgres is the default now (see docker-compose.yml's postgres service).
# DATABASE_URL is derived automatically from POSTGRES_PASSWORD below — only
# set it directly to override (e.g. pointing at a managed/external DB, or
# falling back to SQLite for a throwaway local run with no Postgres).
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# DATABASE_URL=sqlite+aiosqlite:///./data/mms.db

# --- Frontend ---
# Same secret must sign/verify session cookies consistently — generate once,
# keep it stable (rotating it logs everyone out).
SESSION_SECRET=replace-with-a-long-random-string-for-cookie-signing
# The public origin real users hit in their browser (through nginx' TLS).
# In local/dev without a domain yet, https://localhost is fine (self-signed cert).
PUBLIC_ORIGIN=https://your-domain.example
PUBLIC_WS_ORIGIN=wss://your-domain.example
# GIS map tiles: get a free key at https://developer.tomtom.com. Leave unset
# and the map falls back to free CARTO/OSM tiles — nothing breaks either way.
NEXT_PUBLIC_TOMTOM_API_KEY=

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
