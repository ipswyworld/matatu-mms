# Copy this to .env and fill in real values before running:
#   docker compose up -d
#
# Never commit the real .env file — it's already in .gitignore.

# --- Backend ---
BACKEND_SECRET_KEY=replace-with-a-long-random-string-for-jwt-signing
# Secret path segment for the NairobiPay callback URL — NairobiPay doesn't
# sign payloads, so this is the actual authentication. Register your
# callback as https://your-domain/api/payments/nairobipay-callback/<this-value>
NAIROBIPAY_CALLBACK_SECRET=replace-with-a-long-random-string
TERMS_VERSION=2026-07-25
LOG_LEVEL=INFO
# Postgres is the default now (see docker-compose.yml's postgres service).
# DATABASE_URL is derived automatically from POSTGRES_PASSWORD below — only
# set it directly to override (e.g. pointing at a managed/external DB, or
# falling back to SQLite for a throwaway local run with no Postgres).
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# DATABASE_URL=sqlite+aiosqlite:///./data/mms.db

# Uploaded files (SACCO verification docs, enforcement/crime scene photos).
# Leave everything below unset for local dev — app/storage.py falls back to
# local disk under backend/uploads (fine on your own machine, or in
# docker-compose where backend_uploads is a real named volume).
#
# STORAGE_BACKEND=db stores file bytes as a row in Postgres instead — no
# object-storage account or payment method needed, just rides on the
# database this stack already has. That's what render.yaml sets for the
# free-tier Render deploy, where local disk doesn't survive a redeploy.
# STORAGE_BACKEND=db
#
# STORAGE_BACKEND=s3 (or leave unset with these filled in) switches to real
# object storage once there's a bucket with billing set up somewhere (R2,
# B2, Supabase Storage...) — see DEPLOYMENT.md for provider setup steps.
# S3_BUCKET=your-bucket-name
# S3_ENDPOINT_URL=              # leave unset for real AWS S3; set for R2/B2/MinIO
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=https://your-bucket-public-url

# --- Frontend ---
# There are two separate frontends now: matatu-mms/ (staff app — admin,
# enforcement, director/chief officer, viewer; front door /login) and
# matatu-mms-public/ (public app — passengers, crew, Sacco operators; front
# door /). They're independent deployments with independent session
# cookies — cookies aren't shared across the two origins, so each app signs
# its own with its own secret.
#
# Same secret must sign/verify session cookies consistently for a given
# app — generate once per app, keep it stable (rotating it logs everyone
# out of that app).
SESSION_SECRET=replace-with-a-long-random-string-for-cookie-signing
SESSION_SECRET_PUBLIC=replace-with-a-different-long-random-string-for-the-public-app
# matatu-mms-ops (ADMIN_DASHBOARD_AUDIT §4.3 Option B) — its own signing
# secret again, independent of the two above, so a compromise of any one
# app's session cookie can't forge sessions in the others.
OPS_SESSION_SECRET=replace-with-a-third-long-random-string-for-the-ops-console
# The public origin real users hit in their browser (through nginx' TLS).
# In local/dev without a domain yet, https://localhost is fine (self-signed cert).
PUBLIC_ORIGIN=https://your-domain.example
PUBLIC_WS_ORIGIN=wss://your-domain.example
# The public app's own origin — used by the staff app's sign-in page for its
# "Looking to book a ride or manage your Sacco?" link, which now has to
# cross to a different deployment instead of a relative path.
PUBLIC_APP_ORIGIN=https://your-domain.example:3001
# GIS map tiles: get a free key at https://developer.tomtom.com. Leave unset
# and the map falls back to free CARTO/OSM tiles — nothing breaks either way.
NEXT_PUBLIC_TOMTOM_API_KEY=

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
# Real Alertmanager receiver (ADMIN_DASHBOARD_AUDIT §6.5) — a Slack
# incoming webhook. Create one at api.slack.com/apps (your app → Incoming
# Webhooks → Add New Webhook). Required: docker-compose refuses to start
# alertmanager without it rather than silently deploying with no one able
# to actually get paged.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK
